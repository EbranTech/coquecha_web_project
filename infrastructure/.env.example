# Credenciales locales exclusivamente para Docker Compose. No usar en AWS.
MARIADB_ROOT_PASSWORD=coquechas_root_local
MARIADB_PASSWORD=coquechas_app_local

# esta prueba es para despliegue en ec2

# Variables públicas de producción. Docker Compose ya posee estos valores
# como defaults; se pueden sobrescribir sin modificar el archivo Compose.
LARAVEL_PHP_TAG=local
LARAVEL_NGINX_TAG=local
REACT_TAG=local
NEXT_TAG=local
VITE_API_URL=https://api.coquecha.lat/api/v1
VITE_LOGIN_URL=https://app.coquecha.lat/login
VITE_ADMIN_URL=https://app.coquecha.lat/admin
VITE_INDICATORS_URL=https://panel.coquecha.lat
PUBLIC_APP_URL=https://app.coquecha.lat
PUBLIC_OPERATIONS_URL=https://operaciones.coquecha.lat
PUBLIC_PANEL_URL=https://panel.coquecha.lat
OPERATIONS_URL=https://operaciones.coquecha.lat
INDICATORS_URL=https://panel.coquecha.lat
FRONTEND_REACT_URL=https://operaciones.coquecha.lat
DASHBOARD_NEXT_URL=https://panel.coquecha.lat
SANCTUM_STATEFUL_DOMAINS=operaciones.coquecha.lat,panel.coquecha.lat,app.coquecha.lat,api.coquecha.lat
DB_SSL=true
